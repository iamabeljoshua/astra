    "paths": { "vite": ["../apps/web/node_modules/vite/dist/node/index.d.ts"], "@astra/board/test-deck": ["../packages/board/test-deck/index.ts"], "@astra/board/drawing": ["../packages/board/src/drawing.ts"], "@astra/board": ["../packages/board/src/index.ts"], "@astra/contracts": ["../packages/contracts/src/index.ts"] }
  },
  "include": ["."]
}
