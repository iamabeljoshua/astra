{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    // Tests need Node's types, and `vitest/node` brings them in through its optional `@types/node` peer.
    "types": ["vitest/node"]
  },
  "include": ["src", "test"]
}
