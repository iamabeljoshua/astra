{
  "name": "@astra/agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "lab": "node src/lab/open-lab.ts",
    "start": "node src/live/worker.ts start",
    "proof": "node src/lab/proof/run-proof.ts",
    "voice-probe": "node src/lab/proof/voice-probe.ts",
    "voice-proof": "node src/lab/proof/voice/run-voice-proof.ts",
    "math-proof": "node src/lab/proof/math-proof.ts",
    "graph-proof": "node src/lab/proof/graph-proof.ts",
    "math-load": "node src/lab/proof/math-load.ts",
    "eval:tutor": "node src/tutor/eval/run-eval.ts",
    "eval:groups": "node src/tutor/eval/run-groups.ts",
    "eval:board": "node src/tutor/eval/run-groups.ts --file board",
    "eval:switch": "node src/tutor/eval/run-groups.ts --file switch",
    "eval:ink": "node src/tutor/eval/run-ink-table.ts",
    "eval:spoken": "node src/tutor/eval/run-spoken-table.ts",
    "eval:record": "node src/tutor/eval/run-record-table.ts",
    "eval:lessons": "node src/tutor/eval/run-lessons.ts",
    "eval:first-text": "node src/tutor/eval/first-text-ab.ts",
    "lesson": "node src/scenes/lesson/lesson-service.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@astra/board": "workspace:*",
    "@astra/contracts": "workspace:*",
    "@livekit/agents": "1.9.5",
    "@livekit/agents-plugin-elevenlabs": "1.9.5",
    "@livekit/agents-plugin-meta": "1.9.5",
    "@livekit/rtc-node": "1.2.1",
    "livekit-server-sdk": "2.19.2",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.1",
    "typescript": "catalog:",
    "vitest": "^5.1.0"
  }
}
