{
  "name": "@astra/api",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=${NODE_ENV:-development} nest start --watch --preserveWatchOutput",
    "api:types": "nest build && node scripts/generate-api-types.mjs",
    "db": "nest build && node dist/infrastructure/orm/cli.js",
    "typecheck": "tsc",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "jest": "^30.5.2",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "catalog:"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testTimeout": 30000,
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.jest.json",
          "astTransformers": {
            "before": [
              "<rootDir>/../test/swagger-transformer.cjs"
            ]
          }
        }
      ],
      "/jose/.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "target": "ES2022"
          }
        }
      ]
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm/jose@[^/]+/node_modules/)?jose/)"
    ]
  }
}
