{
  "name": "astra",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "api:types": "pnpm --filter @astra/api api:types",
    "db:up": "node supabase/start-stack.mjs",
    "db:migrate": "pnpm --filter @astra/api db migrate",
    "db:reset": "pnpm --filter @astra/api db reset",
    "db:seed": "pnpm --filter @astra/api db seed",
    "db:migration": "pnpm --filter @astra/api db migration",
    "lint": "eslint apps packages --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --no-bail test",
    "lab": "pnpm --filter @astra/agent lab",
    "agent": "pnpm --filter @astra/agent start",
    "verify": "node .claude/skills/verify/scripts/verify.mjs",
    "verify:self": "node .claude/skills/verify/scripts/self-check.mjs",
    "eval:tutor": "pnpm --filter @astra/agent eval:tutor"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.64.1",
    "supabase": "2.75.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1"
  }
}
